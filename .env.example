# Junior College edition: these must point at the JR COLLEGE Supabase project only.
# The app refuses to start against a database whose app_config.edition is not "junior_college".

# Local: `npx supabase start` prints these (API URL / publishable key / service_role key).
NEXT_PUBLIC_JR_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_JR_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used to issue logins and deactivate accounts (see docs/service-role-usage.md).
JR_SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare Turnstile on sign-in / password reset (also enable CAPTCHA in Supabase Auth).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Development only: skip the Principal/Admin MFA redirect. Never set this in production.
JR_REQUIRE_MFA=true
